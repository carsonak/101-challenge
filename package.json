{
  "name": "101-challenge",
  "version": "0.1.0-dev",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "biome lint . && node scripts/boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "test": "pnpm build:packages && node --import tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm docs:check && pnpm test",
    "dev:web": "pnpm build:packages && node --env-file-if-exists=.env scripts/web.mjs dev",
    "dev:worker": "pnpm build:packages && node --env-file-if-exists=.env --import tsx apps/worker/src/index.ts",
    "start:web": "node --env-file-if-exists=.env scripts/web.mjs start",
    "start:worker": "node --env-file-if-exists=.env apps/worker/dist/index.js",
    "services:up": "node scripts/services-up.mjs",
    "services:down": "docker compose down",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
