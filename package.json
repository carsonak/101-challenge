{
  "name": "101-challenge",
  "version": "0.1.0-dev",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.7.0 <25",
    "pnpm": ">=12.9.1 <13"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "biome lint . && node scripts/boundaries.mjs",
    "format": "prettier --write . && pnpm source:format",
    "format:check": "prettier --check . && pnpm source:check",
    "docs:check": "node scripts/docs-check.mjs",
    "test": "pnpm build:packages && node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm docs:check && pnpm openapi:lint && pnpm test",
    "dev:web": "pnpm build:packages && node scripts/local.mjs web-dev",
    "dev:worker": "pnpm build:packages && node scripts/local.mjs worker-dev",
    "start:web": "node scripts/local.mjs web-start",
    "start:worker": "node scripts/local.mjs worker-start",
    "services:up": "pnpm build:packages && node scripts/services-up.mjs",
    "services:down": "docker compose down",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "database:migrate": "pnpm build:packages && node scripts/local.mjs migrate",
    "accounts:maintain": "pnpm build:packages && node scripts/local.mjs maintain",
    "accounts:schedule": "pnpm build:packages && node scripts/local.mjs maintenance",
    "test:browser": "playwright test",
    "discord:register": "pnpm build:packages && node scripts/local.mjs register",
    "discord:proxy": "pnpm build:packages && node scripts/local.mjs proxy",
    "database:provision": "pnpm build:packages && node scripts/local.mjs provision",
    "source:check": "node scripts/source-style.mjs",
    "source:format": "node scripts/source-style.mjs --write",
    "openapi:lint": "redocly lint --config redocly.yaml",
    "openapi:bundle": "node scripts/openapi-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.58.2",
    "@redocly/cli": "2.62.1",
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@challenge/db": "workspace:*"
  }
}
