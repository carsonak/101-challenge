# Local-only defaults. Copy to .env; never commit real credentials.
APP_DISPLAY_NAME="BitDevs Kisumu 101 Challenge"
PORT=3000
WORKER_PORT=3001
WORKER_HOST=127.0.0.1
COMPOSE_PROJECT_NAME=challenge_local
POSTGRES_PORT=5432
POSTGRES_DB=challenge_local
POSTGRES_USER=challenge
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql://challenge:local_development_only@127.0.0.1:5432/challenge_local
QUEUE_SCHEMA=pgboss
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025
# SMTP use is implemented with account features; Mailpit is ready for local testing.
# Optional future login providers: leave ALL fields blank until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_PUBLIC_KEY=
