# Local runtime configuration. Copy to .env; see docs/configuration.md.
# Keep operator, migrator, maintenance and bot credentials in .env.operator.
APP_DISPLAY_NAME="BitDevs Kisumu 101 Challenge"
APP_ORIGIN=http://localhost:3000
PORT=3000
WEB_HOST=127.0.0.1
WORKER_PORT=3001
WORKER_HOST=127.0.0.1
# Windows/WSL: if the web port is reserved, change PORT, APP_ORIGIN and callbacks together.
COMPOSE_PROJECT_NAME=challenge_local
POSTGRES_PORT=5432
POSTGRES_DB=challenge_local
# Distinct restricted logins, provisioned with .env.operator. These are fictional local passwords.
DATABASE_URL=postgresql://challenge_web:local_web_only@127.0.0.1:5432/challenge_local
WORKER_DATABASE_URL=postgresql://challenge_worker:local_worker_only@127.0.0.1:5432/challenge_local
QUEUE_SCHEMA=pgboss

# Mailpit UI and SMTP ports. External Brevo uses SMTP_* below, not MAIL_*.
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=challenge@example.invalid
SMTP_USER=
SMTP_PASSWORD=
# Brevo STARTTLS on port 587: false. Implicit TLS on port 465: true.
SMTP_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_PUBLIC_KEY=
# Exact callback: APP_ORIGIN/api/auth/google/callback or APP_ORIGIN/api/auth/discord/callback.

REPORTING_TIMEZONE=Africa/Nairobi
LOG_FORMAT=auto
# Forwarded addresses stay ignored until an isolated ingress overwrites this header.
TRUSTED_PROXY_HEADER=
TRUSTED_PROXY_HOPS=0
OUTBOX_POLL_MS=2000
OUTBOX_IDLE_MAX_MS=30000
CONTACT_EMAIL=
# Optional owner-controlled recipient for explicitly requested live mail checks.
LIVE_TEST_EMAIL=
# Expose only this loopback proxy through cloudflared. Blank target follows APP_ORIGIN.
DISCORD_PROXY_PORT=3002
DISCORD_PROXY_TARGET=
