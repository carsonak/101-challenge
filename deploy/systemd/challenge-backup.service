[Unit]
Description=Encrypted challenge snapshot and independent deletion ledger
OnFailure=challenge-alert@%n.service

[Service]
Type=oneshot
User=challenge-backup
WorkingDirectory=/opt/101-challenge
EnvironmentFile=/etc/challenge/backup.env
UMask=0077
RuntimeDirectory=challenge-backup
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/flock --wait 300 /run/challenge-backup/backup.lock /usr/bin/env node scripts/backup.mjs backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/challenge-backups
