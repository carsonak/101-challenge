# Local operator configuration. Copy to .env.operator and chmod 600 both private .env files.
# Local pnpm commands scope these settings; web/worker/proxy never read this file.
# Fictional local credentials below must match the role passwords and URL components.
POSTGRES_USER=challenge_operator
POSTGRES_PASSWORD=local_operator_only
OPERATOR_DATABASE_URL=postgresql://challenge_operator:local_operator_only@127.0.0.1:5432/challenge_local
MIGRATOR_DATABASE_URL=postgresql://challenge_migrator:local_migrator_only@127.0.0.1:5432/challenge_local
ERASURE_DATABASE_URL=postgresql://challenge_maintenance:local_maintenance_only@127.0.0.1:5432/challenge_local
MIGRATOR_DB_USER=challenge_migrator
MIGRATOR_DB_PASSWORD=local_migrator_only
WEB_DB_USER=challenge_web
WEB_DB_PASSWORD=local_web_only
WORKER_DB_USER=challenge_worker
WORKER_DB_PASSWORD=local_worker_only
MAINTENANCE_DB_USER=challenge_maintenance
MAINTENANCE_DB_PASSWORD=local_maintenance_only
# Guild registration only. The application ID stays in .env as DISCORD_CLIENT_ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
